# .gitattributes snippet to force users to use same line endings for project.
# 
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

*.json text eol=lf
*.zip binary
# Verification compares generated bytes; preserve the generator's LF on Windows.
schema/**/*.gen.go text eol=lf linguist-generated=true
schema/EXPORTED_IDENTIFIERS.lock text eol=lf linguist-generated=true
